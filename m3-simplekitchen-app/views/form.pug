extends layout

block content
    - data = data || {}

    h2 Registration Form
    p Fill out the form below to register.

    if errors
        ul.my-errors
            each error in errors
                li= error.msg

    form.form-registration(action='/register' method='POST')

        label(for='name') Name:
        input.form-control(
            type='text'
            id='name'
            name='name'
            value=data.name
            required
        )

        label(for='email') Email:
        input.form-control(
            type='email'
            id='email'
            name='email'
            value=data.email
            required
        )

        label(for='username') Username:
        input.form-control(
            type='text'
            id='username'
            name='username'
            value=data.username
            required
        )

        label(for='password') Password:
        input.form-control(
            type='password'
            id='password'
            name='password'
            minlength='8'
            autocomplete='new-password'
            required
        )

        input.btn.btn-lg.btn-primary.btn-block(
            type='submit'
            value='Submit'
        )

    p
        a(href='/') Back to Simple Kitchen